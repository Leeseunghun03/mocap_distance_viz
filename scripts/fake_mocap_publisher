#!/usr/bin/env python3
"""Fake mocap_optitrack output for testing without OptiTrack (ROS1).

Publishes geometry_msgs/PoseStamped on <name>/pose (frame 'world') moving
along a square of side ``~side`` [m] at ``~speed`` [m/s] with Gaussian jitter.
It stays at the start for ``~start_delay`` [s] before moving, and with
``~laps`` > 0 it stops (jitter only) after that many laps.
"""

from __future__ import division

import random

import rospy
from geometry_msgs.msg import PoseStamped


def square_point(s, side):
    s = s % (4.0 * side)
    if s < side:
        return s, 0.0
    if s < 2 * side:
        return side, s - side
    if s < 3 * side:
        return 3 * side - s, side
    return 0.0, 4 * side - s


def main():
    rospy.init_node('fake_mocap_publisher')
    names = rospy.get_param('~rigid_bodies', ['Robot_1'])
    if isinstance(names, str):
        names = [n.strip() for n in names.split(',') if n.strip()]
    rate = float(rospy.get_param('~rate', 120.0))
    side = float(rospy.get_param('~side', 1.0))
    speed = float(rospy.get_param('~speed', 0.5))
    noise = float(rospy.get_param('~noise', 0.0005))
    laps = float(rospy.get_param('~laps', 0.0))
    start_delay = float(rospy.get_param('~start_delay', 0.0))

    pubs = [rospy.Publisher(n + '/pose', PoseStamped, queue_size=1000) for n in names]
    t0 = rospy.Time.now()
    s_end = laps * 4.0 * side if laps > 0 else None
    r = rospy.Rate(rate)
    while not rospy.is_shutdown():
        now = rospy.Time.now()
        s = max(0.0, (now - t0).to_sec() - start_delay) * speed
        if s_end is not None and s >= s_end:
            s = s_end - 1e-9
        x, y = square_point(s, side)
        for i, pub in enumerate(pubs):
            msg = PoseStamped()
            msg.header.stamp = now
            msg.header.frame_id = 'world'
            msg.pose.position.x = x + 2.0 * i + random.gauss(0.0, noise)
            msg.pose.position.y = y + random.gauss(0.0, noise)
            msg.pose.position.z = 0.5 + random.gauss(0.0, noise)
            msg.pose.orientation.w = 1.0
            pub.publish(msg)
        try:
            r.sleep()
        except rospy.ROSInterruptException:
            break


if __name__ == '__main__':
    main()
