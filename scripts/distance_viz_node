#!/usr/bin/env python3
"""Travelled-distance visualizer for mocap_optitrack rigid bodies (ROS1).

Subscribes to the pose topics published by mocap_optitrack
(``<body>/pose`` as geometry_msgs/PoseStamped, or ``<body>/Odom`` as
nav_msgs/Odometry) and, per rigid body, publishes:

  <body>/distance       std_msgs/Float64   cumulative path length [m]
  <body>/displacement   std_msgs/Float64   straight-line distance from start [m]
  <body>/path           nav_msgs/Path      travelled trajectory
  ~markers              visualization_msgs/MarkerArray (text, start point, start->current line)

Service ``~reset`` (std_srvs/Trigger) restarts all measurements.

The terminal running the node shows a live dashboard (TTY), or a one-line
summary per ``~log_period`` when the output is not a terminal.
"""

from __future__ import division, print_function

import math
import threading
import time

import rospy
from geometry_msgs.msg import Point, PoseStamped
from nav_msgs.msg import Odometry, Path
from std_msgs.msg import ColorRGBA, Float64
from std_srvs.srv import Trigger, TriggerResponse
from visualization_msgs.msg import Marker, MarkerArray

from mocap_distance_viz.terminal import BodyRow, Dashboard, is_tty, summary_line
from mocap_distance_viz.tracker import BodyTracker

PALETTE = [
    (0.10, 0.60, 1.00),
    (1.00, 0.45, 0.10),
    (0.20, 0.80, 0.30),
    (0.90, 0.20, 0.50),
    (0.60, 0.40, 1.00),
    (0.95, 0.85, 0.15),
]


class Body(object):
    """Tracker + ROS state (path, publishers) for one rigid body."""

    def __init__(self, name, color, tracker):
        self.name = name
        self.color = color
        self.tracker = tracker
        self.frame_id = 'world'
        self.stamp = rospy.Time(0)
        self.path = []
        self.path_dirty = False
        self.last_rx = None  # wall time of the last valid sample
        self.pub_distance = rospy.Publisher(name + '/distance', Float64, queue_size=10)
        self.pub_displacement = rospy.Publisher(name + '/displacement', Float64, queue_size=10)
        # Latched so that late subscribers get the full path.
        self.pub_path = rospy.Publisher(name + '/path', Path, queue_size=1, latch=True)

    def reset(self):
        self.tracker.reset()
        self.path = []
        self.path_dirty = True
        self.last_rx = None


class DistanceVizNode(object):

    def __init__(self):
        names = rospy.get_param('~rigid_bodies', ['Robot_1'])
        if isinstance(names, str):
            names = [n.strip() for n in names.split(',') if n.strip()]
        msg_type = str(rospy.get_param('~msg_type', 'pose')).lower()
        suffix = rospy.get_param('~topic_suffix', '')
        if msg_type not in ('pose', 'odom'):
            raise ValueError("~msg_type must be 'pose' or 'odom', got '%s'" % msg_type)
        if not suffix:
            suffix = 'pose' if msg_type == 'pose' else 'Odom'

        planar = bool(rospy.get_param('~planar', False))
        min_step = float(rospy.get_param('~min_step', 0.005))
        max_step = float(rospy.get_param('~max_step', 0.5))
        self.max_path_len = int(rospy.get_param('~max_path_length', 20000))
        self.text_height = float(rospy.get_param('~text_height', 0.12))
        self.text_offset_z = float(rospy.get_param('~text_offset_z', 0.35))
        publish_rate = float(rospy.get_param('~publish_rate', 10.0))
        path_rate = float(rospy.get_param('~path_publish_rate', 2.0))
        log_period = float(rospy.get_param('~log_period', 1.0))
        display = str(rospy.get_param('~display', 'auto')).lower()
        display_rate = float(rospy.get_param('~display_rate', 5.0))
        stale_timeout = float(rospy.get_param('~stale_timeout', 0.5))
        if display not in ('auto', 'live', 'log', 'off'):
            raise ValueError("~display must be auto, live, log or off, got '%s'" % display)
        if display == 'auto':
            display = 'live' if is_tty() else 'log'
        self.live = display == 'live'
        self.dashboard = Dashboard(
            rospy.get_name().lstrip('/'),
            'rosservice call %s' % rospy.resolve_name('~reset'),
            stale_timeout=stale_timeout, color=self.live)

        self.lock = threading.Lock()
        self.bodies = []
        for i, name in enumerate(names):
            body = Body(name, PALETTE[i % len(PALETTE)],
                        BodyTracker(name, planar, min_step, max_step))
            self.bodies.append(body)
            topic = name + '/' + suffix
            if msg_type == 'pose':
                rospy.Subscriber(topic, PoseStamped, self._on_pose, body, queue_size=100)
            else:
                rospy.Subscriber(topic, Odometry, self._on_odom, body, queue_size=100)
            rospy.loginfo('[%s] subscribing %s on "%s"', name, msg_type, rospy.resolve_name(topic))

        self.pub_markers = rospy.Publisher('~markers', MarkerArray, queue_size=1)
        rospy.Service('~reset', Trigger, self._on_reset)

        rospy.Timer(rospy.Duration(1.0 / max(publish_rate, 0.1)), self._publish)
        rospy.Timer(rospy.Duration(1.0 / max(path_rate, 0.1)), self._publish_path)
        rospy.loginfo('planar=%s min_step=%.4f m max_step=%.3f m', planar, min_step, max_step)

        # Wall-clock timers, independent of /use_sim_time.
        if self.live:
            self._start_wall_timer(1.0 / max(display_rate, 0.1), self._display_live)
        elif display == 'log' and log_period > 0.0:
            self._start_wall_timer(log_period, self._display_log)

    def _start_wall_timer(self, period, callback):
        def loop():
            while not rospy.is_shutdown():
                time.sleep(period)
                if not rospy.is_shutdown():
                    callback()
        thread = threading.Thread(target=loop)
        thread.daemon = True
        thread.start()

    def _on_pose(self, msg, body):
        self._feed(body, msg.header, msg.pose)

    def _on_odom(self, msg, body):
        self._feed(body, msg.header, msg.pose.pose)

    def _feed(self, body, header, pose):
        p = pose.position
        point = (p.x, p.y, p.z)
        if any(math.isnan(v) for v in point):
            return
        with self.lock:
            added = body.tracker.update(point)
            body.last_rx = time.time()
            if header.frame_id:
                body.frame_id = header.frame_id
            body.stamp = header.stamp
            if added:
                ps = PoseStamped()
                ps.header.frame_id = body.frame_id
                ps.header.stamp = header.stamp
                ps.pose = pose
                body.path.append(ps)
                if 0 < self.max_path_len < len(body.path):
                    del body.path[:len(body.path) - self.max_path_len]
                body.path_dirty = True

    def _on_reset(self, _req):
        with self.lock:
            for body in self.bodies:
                body.reset()
            self.dashboard.reset()
        clear = Marker()
        clear.action = Marker.DELETEALL
        self.pub_markers.publish(MarkerArray(markers=[clear]))
        msg = 'distance reset for: ' + ', '.join(b.name for b in self.bodies)
        # A log line would break the live dashboard redraw.
        (rospy.logdebug if self.live else rospy.loginfo)(msg)
        return TriggerResponse(success=True, message=msg)

    def _publish(self, _event):
        markers = []
        with self.lock:
            for idx, body in enumerate(self.bodies):
                tr = body.tracker
                if not tr.has_data:
                    continue
                disp = tr.displacement()
                body.pub_distance.publish(Float64(tr.distance))
                body.pub_displacement.publish(Float64(disp))
                markers.extend(self._markers_for(idx, body, disp))
        if markers:
            self.pub_markers.publish(MarkerArray(markers=markers))

    def _publish_path(self, _event):
        with self.lock:
            for body in self.bodies:
                if not body.path_dirty:
                    continue
                path = Path()
                path.header.frame_id = body.frame_id
                path.header.stamp = body.stamp
                path.poses = list(body.path)
                body.path_dirty = False
                body.pub_path.publish(path)

    def _markers_for(self, idx, body, disp):
        tr = body.tracker
        r, g, b = body.color
        base_id = idx * 10

        def make(mid, mtype, color):
            m = Marker()
            m.header.frame_id = body.frame_id
            m.header.stamp = body.stamp
            m.ns = body.name
            m.id = base_id + mid
            m.type = mtype
            m.action = Marker.ADD
            m.pose.orientation.w = 1.0
            m.color = color
            return m

        solid = ColorRGBA(r, g, b, 1.0)
        cur = Point(*tr.current)
        start = Point(*tr.start)

        text = make(0, Marker.TEXT_VIEW_FACING, ColorRGBA(1.0, 1.0, 1.0, 1.0))
        text.pose.position = Point(cur.x, cur.y, cur.z + self.text_offset_z)
        text.scale.z = self.text_height
        text.text = '%s\npath: %.3f m\ndisp: %.3f m' % (body.name, tr.distance, disp)

        start_m = make(1, Marker.SPHERE, solid)
        start_m.pose.position = start
        start_m.scale.x = start_m.scale.y = start_m.scale.z = 0.06

        cur_m = make(2, Marker.SPHERE, solid)
        cur_m.pose.position = cur
        cur_m.scale.x = cur_m.scale.y = cur_m.scale.z = 0.05

        line = make(3, Marker.LINE_LIST, ColorRGBA(r, g, b, 0.5))
        line.scale.x = 0.01
        line.points = [start, cur]

        return [text, start_m, cur_m, line]

    def _rows(self):
        now = time.time()
        rows = []
        with self.lock:
            for body in self.bodies:
                tr = body.tracker
                if not tr.has_data:
                    rows.append(BodyRow(body.name, body.color, False))
                    continue
                rows.append(BodyRow(
                    body.name, body.color, True, tr.distance, tr.displacement(),
                    tr.current, now - body.last_rx, tr.jumps))
        return rows

    def _display_live(self):
        self.dashboard.draw(self._rows())

    def _display_log(self):
        rospy.loginfo(summary_line(self._rows(), self.dashboard))


def main():
    rospy.init_node('mocap_distance_viz')
    DistanceVizNode()
    rospy.spin()


if __name__ == '__main__':
    main()
