<launch>
  <node pkg="mocap_distance_viz" type="distance_viz_node" name="mocap_distance_viz">
    <rosparam>
      rigid_bodies: [Robot_1, Robot_2]
      log_period: 0.0
    </rosparam>
  </node>
  <!-- One lap of a 1 m square (4 m), then stationary -->
  <node pkg="mocap_distance_viz" type="fake_mocap_publisher" name="fake_mocap_publisher">
    <rosparam>
      rigid_bodies: [Robot_1, Robot_2]
      speed: 1.0
      laps: 1
      start_delay: 2.0
    </rosparam>
  </node>
  <test test-name="test_integration" pkg="mocap_distance_viz" type="test_integration.py" time-limit="60.0"
        launch-prefix="python$(env ROS_PYTHON_VERSION)"/>
</launch>
