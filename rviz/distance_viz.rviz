Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.3
    - Class: rviz/MarkerArray
      Name: Distance
      Enabled: true
      Marker Topic: /mocap_distance_viz/markers
      Queue Size: 5
    - Class: rviz/Path
      Name: Robot_1 Path
      Enabled: true
      Color: 25; 153; 255
      Line Style: Lines
      Topic: /Robot_1/path
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Interact
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 6
      Focal Point: {X: 0, Y: 0, Z: 0}
      Pitch: 0.8
      Yaw: 0.8
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 800
  Width: 1200
