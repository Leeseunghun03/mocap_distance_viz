<launch>
  <!-- Run alongside mocap_optitrack (mocap.launch). -->
  <arg name="config" default="$(find mocap_distance_viz)/config/distance_viz.yaml"/>
  <arg name="rviz" default="false" doc="Start RViz"/>
  <arg name="fake" default="false" doc="Publish fake mocap data (no OptiTrack needed)"/>

  <node pkg="mocap_distance_viz" type="distance_viz_node" name="mocap_distance_viz" output="screen">
    <rosparam command="load" file="$(arg config)"/>
  </node>

  <node if="$(arg fake)" pkg="mocap_distance_viz" type="fake_mocap_publisher" name="fake_mocap_publisher" output="screen">
    <rosparam command="load" file="$(arg config)"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find mocap_distance_viz)/rviz/distance_viz.rviz"/>
</launch>
